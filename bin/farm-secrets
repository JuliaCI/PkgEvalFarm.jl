#!/usr/bin/env bash
# Backup and restore the farm's out-of-band SSM parameters (bot GitHub token,
# webhook secret, Buildkite token, ...). Terraform only creates placeholders
# for these (value = "placeholder-set-out-of-band", ignore_changes), so a
# region migration or disaster recovery needs the real values carried over:
#
#   bin/farm-secrets backup  --region us-east-1 -o secrets.json
#   bin/farm-secrets restore --region us-east-2 -i secrets.json
#
# or, with no file touching disk:
#
#   bin/farm-secrets backup --region us-east-1 | bin/farm-secrets restore --region us-east-2
#
# Restore must run AFTER `tofu apply` in the target region: put-parameter
# would otherwise create the parameters first and terraform's placeholder
# resources would then fail with ParameterAlreadyExists.
#
# Needs admin-ish credentials (ssm:GetParametersByPath with decryption,
# ssm:PutParameter under /pkgeval) — run it as yourself, not the debug role.
set -euo pipefail

PATH_PREFIX="/pkgeval"
usage() {
    echo "usage: farm-secrets backup  [--region <r>] [--path $PATH_PREFIX] [-o <file>]" >&2
    echo "       farm-secrets restore [--region <r>] [--path $PATH_PREFIX] [-i <file>]" >&2
    exit 1
}

cmd="${1:-}"; shift || usage
region_args=() file="-"
while [ $# -gt 0 ]; do
    case "$1" in
        --region) region_args=(--region "$2"); shift 2 ;;
        --path)   PATH_PREFIX="$2"; shift 2 ;;
        -o|-i)    file="$2"; shift 2 ;;
        *) usage ;;
    esac
done

command -v jq >/dev/null || { echo "farm-secrets: jq is required" >&2; exit 1; }

case "$cmd" in
backup)
    # keep Name/Type/Value only: ARNs and Version are region/history-specific
    out=$(aws ssm get-parameters-by-path "${region_args[@]}" \
              --path "$PATH_PREFIX" --recursive --with-decryption \
              --query 'Parameters[].{Name: Name, Type: Type, Value: Value}' \
              --output json)
    n_placeholder=$(jq '[.[] | select(.Value | startswith("placeholder"))] | length' <<<"$out")
    [ "$n_placeholder" -gt 0 ] && \
        echo "farm-secrets: warning: $n_placeholder parameter(s) still hold placeholder values" >&2
    echo "farm-secrets: backed up $(jq length <<<"$out") parameter(s) under $PATH_PREFIX" >&2
    if [ "$file" = "-" ]; then
        printf '%s\n' "$out"
    else
        (umask 077 && printf '%s\n' "$out" > "$file")
    fi
    ;;
restore)
    if [ "$file" = "-" ]; then in=$(cat); else in=$(cat "$file"); fi
    count=$(jq length <<<"$in")
    [ "$count" -gt 0 ] || { echo "farm-secrets: nothing to restore" >&2; exit 1; }
    # --cli-input-json over stdin keeps secret values out of process argv
    jq -c '.[] | . + {Overwrite: true}' <<<"$in" | while IFS= read -r param; do
        aws ssm put-parameter "${region_args[@]}" \
            --cli-input-json "$param" --output text --query Version >/dev/null
        echo "farm-secrets: restored $(jq -r .Name <<<"$param")" >&2
    done
    echo "farm-secrets: restored $count parameter(s)" >&2
    ;;
*) usage ;;
esac
