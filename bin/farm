#!/bin/sh
# Convenience wrapper for running the CLI straight from a checkout, equivalent to
# the `farm` app installed by `Pkg.Apps` (see `[apps]` in Project.toml). Set
# JULIA to pick a specific julia, e.g. JULIA="julia +1.12".
#
# PKGEVAL_SYSIMAGE points at a sysimage holding the worker and its dependencies
# (built by sysimage/build.jl, fetched at boot by EC2 workers). Ignored if the
# file has gone missing, since the only cost of not using it is precompilation.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SYSIMAGE_FLAG=
[ -f "${PKGEVAL_SYSIMAGE:-}" ] && SYSIMAGE_FLAG="-J$PKGEVAL_SYSIMAGE"
exec ${JULIA:-julia} $SYSIMAGE_FLAG --project="$SCRIPT_DIR" --startup-file=no -m PkgEvalFarm "$@"
